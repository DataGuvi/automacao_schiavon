# Modelo de profile do RPA Schiavon. NAO coloque segredo neste arquivo: ele e versionado.
#
# Uso: copie para o ambiente desejado e preencha.
#     resources/config-dev.env    (desenvolvimento / homologacao)
#     resources/config-prod.env   (producao)
# Os dois ficam fora do git (.gitignore: resources/config-*.env).
#
# O profile ativo sai da variavel de ambiente RPA_ENV (dev | prod). Sem RPA_ENV,
# o robo usa `prod`. RPA_ENV invalido derruba a execucao no inicio.
#
# Formato estrito CHAVE=VALOR (o separador ':' NAO e aceito). Linhas iniciadas
# por '#' sao comentario. Valor com espaco ou '#' vai entre aspas.
# Tipagem e validacao: domain/config.py.

# --- PostgreSQL (obrigatorio: sem estas 5 chaves o robo nao inicia) ---
HOST=
PORT=5432
DATABASE=
USER_GUVI=
PASSWORD_GUVI=
# schema no search_path da conexao (default: public)
SCHEMA=dwschiavon2

# --- SharePoint: invoices (FLUXO 2) ---
SHAREPOINT_USERNAME=
SHAREPOINT_PASSWORD=
# --- SharePoint: cotacao (FLUXO 3, outra conta) ---
SHAREPOINT_USERNAME2=
SHAREPOINT_PASSWORD2=

# --- Claude Vision (FLUXO 2) ---
schiavon_key_vision=
# default: claude-sonnet-4-6
VISION_MODEL=

# --- ERP Catapult / ECRS (FLUXO 4) ---
ECRS_USER=
ECRS_PASSWORD=
CLOUDFLARE_ACCESS_EMAIL=
ECRS_HQ=
ECRS_WINDERMERE=
ECRS_DRPHILIPS=
# true (default) roda sem janela; false abre o navegador para depurar seletor
ECRS_HEADLESS=true

# --- Google Sheets: planilha De-Para/Pendentes (FLUXOS 1 e 4) ---
SINONIMOS_SHEET_ID=
# --- Google Sheets: planilha Conferencia Manual (preambulo e FLUXO 4) ---
CONFERENCIA_MANUAL_SHEET_ID=

# --- SMTP: cotacao ao fornecedor e alertas a operacao ---
SMTP_HOST=
# 465 = SSL direto; 587 = STARTTLS (pode ser bloqueada por antivirus/firewall)
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# destinatario dos alertas do monitor (default: dataguvi@gmail.com)
ALERTA_EMAIL=

# --- Twilio / WhatsApp (FLUXO 3) ---
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_CONTENT_SID=
